# Server port
PORT=3000

# MongoDB connection string (local, Docker Compose, or MongoDB Atlas)
# Example local: mongodb://127.0.0.1:27017/attendance
# Example Docker: mongodb://mongo:27017/attendance
# Example Atlas: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/attendance?retryWrites=true&w=majority
MONGO_URI="mongodb://127.0.0.1:27017/attendance"
